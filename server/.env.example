# JuiceFS File Upload Demo Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
SERVER_PORT=8080

# JuiceFS Mount Paths
JUICEFS_MOUNT_PATH=/juicefs-redis
JUICEFS_MOUNT_PATH_POSTGRES=/juicefs-postgres

# Redis Configuration (Metadata Engine Option 1)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=1
REDIS_URL=redis://:your_redis_password@localhost:6379/1

# PostgreSQL Configuration (Metadata Engine Option 2)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=juicefs
POSTGRES_USER=juicefs
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_URL=postgres://juicefs:your_postgres_password@localhost:5432/juicefs?sslmode=disable

# MinIO Configuration (Object Storage Backend)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_ACCESS_KEY=juicefs
MINIO_SECRET_KEY=juicefs_secret
MINIO_BUCKET=juicefs
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# JuiceFS Configuration
JUICEFS_NAME_REDIS=myjfs-redis
JUICEFS_NAME_POSTGRES=myjfs-postgres
JUICEFS_CACHE_DIR=/var/jfsCache
JUICEFS_CACHE_SIZE=1024
JUICEFS_MAX_UPLOADS=50
JUICEFS_MAX_DELETES=50

# Application Settings
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=*
UPLOAD_PATH=uploads
LOG_LEVEL=info